# monitoring.wosool.ai -> Postiz. Lives at /opt/wosool-hub/sites/postiz.caddy (owned by the postiz
# project, not wosool-hub). Caddy runs `admin off`: after changing this file, `docker restart wosool-caddy`.
monitoring.wosool.ai {
	encode zstd gzip
	request_body {
		max_size 1GB
	}
	# MCP OAuth: the backend lives under /api here, but its OAuth metadata names the resource and the discovery
	# documents at the root (/mcp-oauth-*, /.well-known/oauth-*). Send exactly those paths to the backend.
	@mcpoauth path /mcp-oauth-* /.well-known/oauth-protected-resource* /.well-known/oauth-authorization-server*
	rewrite @mcpoauth /api{uri}
	reverse_proxy postiz:5000 {
		# MCP uses streamable HTTP: never buffer responses.
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
